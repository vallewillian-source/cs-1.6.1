# Conteúdo baixado/gerado — recriável pelos passos do README.md
/src/
/steamcmd/
/backups/

# server/: só o que escrevemos à mão fica versionado
/server/*
!/server/run-server.sh
!/server/cstrike
/server/cstrike/*
!/server/cstrike/server.cfg
!/server/cstrike/game_init.cfg
!/server/cstrike/listip.cfg
!/server/cstrike/banned.cfg

# game/: só o launcher e configs escritos à mão ficam versionados
/game/*
!/game/run-cs.sh
!/game/cstrike
/game/cstrike/*
!/game/cstrike/cstrike.rc

# Logs e temporários
*.log
/tmp/
.video_agent/

# Builds dos Mods (fontes ficam em mods/*/; binários vão para game/mods/)
mods/null/*.so
mods/vr/*.so
