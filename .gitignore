# Conteúdo baixado/gerado — recriável pelos passos do README.md
/src/
/steamcmd/
/backups/

# server/: só o que escrevemos à mão fica versionado
/server/*
!/server/run-server.sh
!/server/cstrike
/server/cstrike/*
!/server/cstrike/server.cfg
!/server/cstrike/game_init.cfg
!/server/cstrike/listip.cfg
!/server/cstrike/banned.cfg
# bots + cérebro Jev (docs/BOTBRAIN.md): config, perfis de bot e nav do dust2
!/server/cstrike/advisor.cfg
!/server/cstrike/BotProfile.db
!/server/cstrike/BotChatter.db
!/server/cstrike/maps
/server/cstrike/maps/*
!/server/cstrike/maps/de_dust2.nav

# runtime do advisor (observe/plan/cache) e rastros do sidecar
/server/cstrike/advisor/
tools/botbrain/traces/
__pycache__/

# game/: só o launcher e configs escritos à mão ficam versionados
/game/*
!/game/run-cs.sh
!/game/cstrike
/game/cstrike/*
!/game/cstrike/cstrike.rc

# Logs e temporários
*.log
/tmp/
.video_agent/

# Estado de sessão das ferramentas de desenvolvimento (não é conteúdo do projeto)
.zcode/

# Builds dos Mods (fontes ficam em mods/*/; binários vão para game/mods/)
mods/null/*.so
mods/vr/*.so
