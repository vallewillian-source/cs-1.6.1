+}
+
+/*
+================
+IN_HudPointerTest
+
+Debug (cvar hud_ptr_test, off por padrão): pilota o cursor VIRTUAL do menu sem
+Mod nenhum — varre a tela e dá um clique por volta. É a única forma de validar o
+caminho canvas → cursor → clique (UI_MouseMove / K_MOUSE1 → UI_KeyEvent) num run
+sem headset: abre-se o menu por comando (`togglemenu`) e se lê o log/o print.
+
+Não misturar com VR ligado: os dois escreveriam o mesmo cursor.
+================
+*/
+static void IN_HudPointerTest( void )
+{
+	// espaço 2D do engine (o mesmo em que o mouse do SO chega: ver
+	// Platform_GetMousePos × refState.scale_x)
+	const float w = (float)refState.width, h = (float)refState.height;
+	const float t = fmodf( (float)host.realtime * 0.20f, 2.0f ); // 10 s por volta
+	const float phase = ( t < 1.0f ? t : 2.0f - t );             // vai e volta
+	// varredura em DOIS eixos (períodos diferentes) de propósito: os menus do
+	// jogo são uma lista vertical, então só um X deslizante nunca passaria por
+	// mais de um item e o hover não poderia ser observado
+	const float tv = fmodf( (float)host.realtime * ( 2.0f / 7.0f ), 2.0f );
+	const float phasev = ( tv < 1.0f ? tv : 2.0f - tv );
+	int x = (int)( w * ( 0.15f + 0.70f * phase ));
+	int y = (int)( h * ( 0.40f + 0.35f * phasev ));
+	// janela do clique: em vez de clicar no meio da varredura (onde não há item
+	// nenhum), estaciona em cima do item "Resume" do menu de pausa — se o clique
+	// valer, o menu FECHA e o engine volta para key_game (o teste loga a
+	// transição, que é a prova de que o clique chegou ao item). A janela é no
+	// FIM da volta (t > 0,92) de propósito: no começo o carregamento do mapa
+	// ainda está em curso e o próprio spawn fecha o menu no meio do clique
+	const bool click_win = ( t >= 0.92f );
+	int btn;
+
+	if( click_win )
+	{
+		x = (int)( w * 0.16f ); // ~307 px: dentro do rótulo dos itens
+		y = (int)( h * 0.30f ); // ~324 px: sobre "Resume"
+	}
+
+	btn = click_win ? 1 : 0;
+	static int last_x = -1;
+	static int last_btn = -1;
+	static int last_dest = -1;
+
+	// modo 2 (hud_ptr_test 2): além de dirigir o cursor, ABRE e FECHA o menu
+	// sozinho — é o que torna possível validar o caminho inteiro (canvas →
+	// cursor → clique) sem nenhuma entrada do usuário, já que comandos depois de
+	// `+map` na linha de comando se perdem no carregamento do mapa.
+	//
+	// modo 3 (hud_ptr_test 3): abre o menu de COMPRA de verdade pelo comando de
+	// cliente `showvguimenu 28` (MENU_BUY — o mesmo caminho da tecla `b`) e o
+	// deixa aberto. É o conteúdo REAL que o painel do headset mostra, com o HUD
+	// do jogo desenhado por cima — o que se quer medir num dump do canvas.
+	if( hud_ptr_test.value >= 2.0f && cls.state == ca_active )
+	{
+		const float cyc = fmodf( (float)host.realtime, 24.0f ); // 24 s por ciclo
+		static qboolean menu_real_once;
+
+		if( hud_ptr_test.value >= 3.0f )
+		{
+			// espera o spawn assentar (o spawn fecha menu) e abre UMA vez
+			if( host.realtime > 6.0 && !menu_real_once )
+			{
+				menu_real_once = true;
+				Cbuf_AddText( "showvguimenu 28\n" );
+			}
+		}
+		else if( cyc > 3.0f && cyc < 18.0f )
+		{
+			if( cls.key_dest == key_game )
+				UI_SetActiveMenu( true ); // abre (mesmo caminho do ESC)
+		}
+		else if( cls.key_dest == key_menu )
+		{
+			UI_SetActiveMenu( false ); // fecha
+		}
+	}
+
+	// fora de menu não há cursor de UI para dirigir (e o mouse look não passa
+	// por aqui: ele usa os deltas relativos)
+	if( cls.key_dest == key_game )
+	{
+		IN_SetVirtualCursor( false, 0, 0 );
+		return;
+	}
+
+	IN_SetVirtualCursor( true, x, y );
+	IN_SetVirtualButton( btn );
+
+	// o estado do menu é a evidência de que o teste está no caminho certo: sem
+	// menu aberto não há canvas, não há UI para o clique e o virtual não vale
+	if( (int)cls.key_dest != last_dest )
+	{
+		last_dest = cls.key_dest;
+		Con_Printf( "hud_ptr_test: key_dest=%s (menu visivel=%d) em %.1fs\n",
+			cls.key_dest == key_game ? "game" : ( cls.key_dest == key_menu ? "menu" : "console" ),
+			UI_IsVisible() ? 1 : 0, host.realtime );
+	}
+
+	if( abs( x - last_x ) > (int)( w / 16 ) || btn != last_btn )
+	{
+		last_x = x;
+		last_btn = btn;
+		Con_Printf( "hud_ptr_test: cursor virtual (%d,%d) em %dx%d%s\n", x, y, refState.width,
+			refState.height, btn ? " + CLIQUE" : "" );
+	}
+}
