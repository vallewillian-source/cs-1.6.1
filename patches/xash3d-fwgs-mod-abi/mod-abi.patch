+/*
+=================
+GL_FrustumInitProjAsym
+
+Mesma construção do GL_FrustumInitProj, mas com os QUATRO semi-ângulos da view
+— o frustum fora de centro de quem tem ótica canted/por olho (game mods,
+RF_FOV_ASYM). Os ângulos chegam em RADIANOS e no sinal do OpenXR (left/down
+negativos, right/up positivos), que são exatamente os números que
+R_SetupProjectionMatrix usa. Assim o culling e a imagem passam a enxergar a
+MESMA região.
+
+Por que não reaproveitar o simétrico: fov_x/fov_y só expressam um retângulo
+CENTRADO, então um frustum assimétrico só pode ser coberto por um envelope —
+sobra no lado largo e FALTA no lado estreito. Pior: os campos do engine são
+aberturas TOTAIS (ele divide por dois internamente), então quem publicar um
+meio-ângulo ali encolhe o culling à metade da abertura e o mundo desaparece nas
+beiradas (era o caso antes desta função existir).
+=================
+*/
+void GL_FrustumInitProjAsym( gl_frustum_t *out, float flZNear, float flZFar, float flAngleLeft, float flAngleRight, float flAngleUp, float flAngleDown )
+{
+	vec3_t	normal, iforward;
+	float	xs, xc;
+
+	// Cada plano é a ARESTA daquele lado, com a normal virada para DENTRO da
+	// cunha (é o lado positivo que o culling conserva). A aresta esquerda está
+	// em flAngleLeft (negativo no OpenXR) e o interior fica à direita dela, então
+	// a normal é (sen|L|, +cos|L|) no plano (frente, direita); a direita é a
+	// mesma conta com o sinal do cosseno trocado. Repare que o nome do plano
+	// aqui aponta para a aresta que ele limita — no GL_FrustumInitProj simétrico
+	// os dois acabam trocados entre si (a cunha é a mesma, simétrica).
+	SinCos( fabsf( flAngleLeft ), &xs, &xc );
+	VectorMAM( xs, RI.cull_vforward, xc, RI.cull_vright, normal );
+	GL_FrustumSetPlane( out, FRUSTUM_LEFT, normal, DotProduct( RI.cullorigin, normal ));
+
+	SinCos( flAngleRight, &xs, &xc );
+	VectorMAM( xs, RI.cull_vforward, -xc, RI.cull_vright, normal );
+	GL_FrustumSetPlane( out, FRUSTUM_RIGHT, normal, DotProduct( RI.cullorigin, normal ));
+
+	VectorNegate( RI.cull_vforward, iforward );
+
+	SinCos( fabsf( flAngleDown ), &xs, &xc );
+	VectorMAM( xs, RI.cull_vforward, xc, RI.cull_vup, normal );
+	GL_FrustumSetPlane( out, FRUSTUM_BOTTOM, normal, DotProduct( RI.cullorigin, normal ));
+
+	SinCos( flAngleUp, &xs, &xc );
+	VectorMAM( xs, RI.cull_vforward, -xc, RI.cull_vup, normal );
+	GL_FrustumSetPlane( out, FRUSTUM_TOP, normal, DotProduct( RI.cullorigin, normal ));
+
+	// setup far plane
+	vec3_t farpoint;
+	VectorMA( RI.cullorigin, flZFar, RI.cull_vforward, farpoint );
+	GL_FrustumSetPlane( out, FRUSTUM_FAR, iforward, DotProduct( iforward, farpoint ));
+
+	// no need to setup backplane for general view.
+	if( flZNear == 0.0f ) return;
+
+	// setup near plane
+	vec3_t nearpoint;
+	VectorMA( RI.cullorigin, flZNear, RI.cull_vforward, nearpoint );
+	GL_FrustumSetPlane( out, FRUSTUM_NEAR, RI.cull_vforward, DotProduct( RI.cull_vforward, nearpoint ));
+}
