+/*
+================
+IN_SetVirtualButton
+
+Botão esquerdo do cursor virtual. O engine gera o evento só na BORDA (o menu
+baseia o hover na posição e a ativação no KeyDownEvent/KeyUpEvent).
+================
+*/
+void IN_SetVirtualButton( int down )
+{
+	qboolean want = down ? true : false;
+
+	if( want == in_vcursor_btn )
+		return;
+
+	in_vcursor_btn = want;
+	IN_MouseEvent( 0, want ? 1 : 0 );
+}
