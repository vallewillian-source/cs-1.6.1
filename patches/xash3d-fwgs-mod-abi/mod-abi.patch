+/*
+================
+IN_GetCursorPos
+
+Posição ABSOLUTA do cursor no espaço 2D do engine, em pixels de render — a
+mesma unidade que o menu usa (mainui clampa em ScreenWidth/Height e o client
+DLL repassa para o g_pMenu->MouseMove). Com o cursor virtual ativo (VR/menus) o
+mouse do SO não é consultado; senão é o comportamento de sempre.
+
+Devolve true quando a posição veio do cursor virtual.
+================
+*/
+qboolean IN_GetCursorPos( int *x, int *y )
+{
+	if( in_vcursor_on )
+	{
+		if( x ) *x = in_vcursor_x;
+		if( y ) *y = in_vcursor_y;
+		return true;
+	}
+
+	Platform_GetMousePos( x, y );
+	return false;
+}
+
+/*
+================
+IN_SetVirtualCursor
+
+Chamado pelo modloader/cliente (ABI v8). Ativa/desativa o cursor virtual e dá
+a posição. Desativar SOLTA o botão sintético: sem isto, um clique que estava
+pressionado quando o menu fechou ficaria preso no in_mstate e o jogo seguiria
+com MOUSE1 apertado (o engine só limpa isso em IN_ClearMouseState).
+================
+*/
+void IN_SetVirtualCursor( qboolean active, int x, int y )
+{
+	if( !active && in_vcursor_btn )
+		IN_MouseEvent( 0, 0 ); // solta antes de sair
+
+	in_vcursor_on = active;
+
+	if( active )
+	{
+		in_vcursor_x = x;
+		in_vcursor_y = y;
+	}
+}
