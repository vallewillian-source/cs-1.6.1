+/*
+modloader.h — hooks do sistema de Mods externos (ver mod_api.h).
+
+Call sites no engine:
+  - Host_Init            → Mods_Init        (parse "-mod <nome>", load)
+  - Host_Frame           → Mods_FramePre / Mods_Hud / Mods_Input / Mods_FramePost
+  - Host_ShutdownWithReason → Mods_Shutdown (unload limpo)
+  - SCR_UpdateScreen     → Mods_BeginFrame / Mods_EndFrame
+  - V_RenderView         → Mods_Camera      (por view pass / por olho)
+  - V_RenderView         → Mods_ViewModel   (v6: arma na mão, pós-Mods_Camera, por olho)
+  - Key_Event (input)    → Mods_Key         (v7: tecla antes de todo handler; consumível)
+  - V_PostRender         → Mods_Overlay2D   (2D pronto, antes do swap)
+  - platform sdl2 vid    → Mods_VideoInit   (janela + contexto GL prontos)
+
+Nota (v8): Mods_Hud NÃO é mais a antiga notificação de "o 2D vai ser desenhado"
+(esse lugar era o SCR_UpdateScreen, com o nome Mods_HudFrame). Ele é o
+intercâmbio por frame que decide o canvas 2D e o cursor do menu, e por isso roda
+em Host_Frame, ANTES do input frame — assim o cursor vale para o frame que está
+começando.
+*/
+#ifndef MODLOADER_H
+#define MODLOADER_H
+
+#include "ref_params.h" // ref_viewpass_t
+#include "mod_api.h"    // mod_input_sample_t
+
+qboolean    Mods_Active( void );
+const char *Mods_Name( void );
+
+void Mods_Init( void );
+void Mods_Shutdown( void );
+
+void Mods_FramePre( double time );
+void Mods_FramePost( double time );
+// consulta o Mod 1x por frame (Host_Frame); a amostra fica guardada para o
+// CL_CreateCmd aplicar via Mods_GetInput
+void Mods_Input( void );
+// amostra do frame corrente; falso se não há Mod de input ou ele não foi
+// consultado neste frame
+qboolean Mods_GetInput( mod_input_sample_t *out );
+
+// rvp pode ser modificado pelo Mod (origem/ângulos/fov/viewport)
+void Mods_Camera( ref_viewpass_t *rvp, int eye );
+
+// arma na mão (v6): consulta o Mod com a struct pré-preenchida pelo chamador
+// (cl_view.c, que conhece clgame) e devolve true quando houve Mod de display.
+// Quem aplica origem/ângulos/flags é o chamador — o modloader não conhece o
+// cliente. Chamar DEPOIS de Mods_Camera e POR OLHO (ver mod_api.h).
+qboolean Mods_ViewModel( mod_viewmodel_t *vm );
+
+// teclado (v7): chamado no topo do Key_Event — o Mod vê a tecla antes do OSK,
+// do console, do menu e do cliente DLL. True = o Mod consumiu o evento e o
+// engine encerra o Key_Event ali (a tecla não chega ao jogo nem aos binds).
+qboolean Mods_Key( int key, int down );
+
+// estéreo: nº de passes de render por frame (1 = mono, 2 = um por olho)
+int  Mods_EyeCount( void );
+// após o loop de olhos, antes do desenho 2D (bind do framebuffer da janela)
+void Mods_AfterEyes( void );
+
+void Mods_VideoInit( void *window, void *gl_context );
+void Mods_BeginFrame( void );
+void Mods_EndFrame( void );
+// v8: HUD/UI 2D. O chamador pré-preenche a ENTRADA e lê as SAÍDAS (ver
+// mod_hud_t em mod_api.h); false = não há Mod de HUD carregado.
+qboolean Mods_Hud( mod_hud_t *hud );
+// último ponto 2D do frame: HUD/menus já desenhados, swap ainda não feito.
+// É o único lugar em que um Mod pode desenhar POR CIMA da UI do jogo.
+void Mods_Overlay2D( void );
+
+#endif // MODLOADER_H
