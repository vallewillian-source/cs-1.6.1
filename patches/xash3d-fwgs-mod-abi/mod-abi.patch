+/*
+================
+IN_GetCursorPos
+
+Posição ABSOLUTA do cursor no espaço 2D do engine, em pixels de render — a
+mesma unidade que o menu usa (mainui clampa em ScreenWidth/Height e o client
+DLL repassa para o g_pMenu->MouseMove). Com o cursor virtual ativo (VR/menus) o
+mouse do SO não é consultado; senão é o comportamento de sempre.
+
+Devolve true quando a posição veio do cursor virtual.
+================
+*/
+qboolean IN_GetCursorPos( int *x, int *y )
+{
+	if( in_vcursor_on )
+	{
+		if( x ) *x = in_vcursor_x;
+		if( y ) *y = in_vcursor_y;
+		return true;
+	}
+
+	Platform_GetMousePos( x, y );
+	return false;
+}
