+void IN_SetVirtualCursor( qboolean active, int x, int y )
+{
+	if( !active && in_vcursor_btn )
+		IN_MouseEvent( 0, 0 ); // solta antes de sair
+
+	in_vcursor_on = active;
+
+	if( active )
