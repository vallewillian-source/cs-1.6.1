+/*
+==================
+CL_ModHud
+
+HUD/UI 2D (ABI v8). Um lugar por frame, no começo dele (Host_Frame, antes do
+input frame — é isso que faz o cursor valer para o frame que está começando):
+
+  1. monta os FATOS que o Mod não tem como saber: há menu aberto? qual é o
+     tamanho do espaço 2D? a textura do canvas do frame passado?
+  2. chama Mods_Hud — o Mod devolve se quer o canvas e onde está o cursor dele
+     (o ponteiro do controle que o VR usa como mouse);
+  3. aplica: liga/desliga o cursor virtual (que os DOIS consumidores de cursor do
+     engine leem) e guarda o pedido de canvas para o V_PostRender.
+
+"Menu aberto" é `cls.key_dest == key_menu`: o menu do ESC (mainui) e os menus do
+client — time, classe, compra — todos marcam KEY_MENU ao abrir, então este
+predicado cobre esc/m/b sem precisar perguntar nada a ninguém. De propósito NÃO é
+`!= key_game`: isso incluiria o CONSOLE (key_console) e o modo de mensagem, e aí
+abrir o console ligaria o painel do headset sem menu nenhum dentro dele.
+
+Sem Mod de HUD (jogo flat, -mod null) NADA disto tem efeito: o cursor volta a ser
+o do SO e o 2D segue indo direto para a janela.
+==================
+*/
+static mod_hud_t cl_hud;
+
+void CL_ModHud( void )
+{
+	memset( &cl_hud, 0, sizeof( cl_hud ));
+	cl_hud.size = sizeof( cl_hud );
+
+	cl_hud.menu_open = ( cls.key_dest == key_menu ) ? 1 : 0;
+	cl_hud.ui_visible = UI_IsVisible() ? 1 : 0;
+	// o espaço 2D do engine: é nele que o mouse do SO chega escalado
+	// (Platform_GetMousePos × refState.scale_x) e é o tamanho que o ref usa na
+	// projeção 2D — ou seja, é também o tamanho do canvas
+	cl_hud.canvas_w = refState.width;
+	cl_hud.canvas_h = refState.height;
+
+	if( ref.initialized )
+		ref.dllFuncs.R_HudCanvasInfo( (int *)&cl_hud.canvas_tex, NULL, NULL );
+
+	if( !Mods_Hud( &cl_hud ))
+	{
+		// não há Mod de HUD: o mouse do SO manda e o 2D vai para a janela
+		IN_SetVirtualCursor( false, 0, 0 );
+		return;
+	}
+
+	// debug (hud_ptr_test): força o canvas DEPOIS do Mod — o override de teste
+	// tem de vencer a decisão do Mod, senão um Mod inativo (VR desligado) zera o
+	// pedido e o caminho do canvas nunca é exercitado (ver IN_HudPointerTest)
+	if( IN_HudPointerTestActive())
+		cl_hud.want_canvas = 1;
+
+	// O Mod só manda o ponteiro quando quer, e o engine só obedece com MENU
+	// ABERTO: fora de menu não há UI no comando e obedecer seria sequestrar o
+	// mouse do jogo por engano (o jogo normal tem de ficar intocado).
+	if( cl_hud.has_pointer && cl_hud.menu_open )
+	{
+		IN_SetVirtualCursor( true, (int)cl_hud.x, (int)cl_hud.y );
+		IN_SetVirtualButton( cl_hud.buttons & 1 );
+	}
+	else
+	{
+		IN_SetVirtualCursor( false, 0, 0 );
+		IN_SetVirtualButton( 0 );
+	}
+}
+
+qboolean CL_HudWantsCanvas( void )
+{
+	// dupla trava de propósito: o Mod decide, e o engine só aceita com menu
+	// aberto — um Mod com bug não pode sequestrar o caminho 2D do jogo inteiro
+	return ( cl_hud.want_canvas && cl_hud.menu_open ) ? true : false;
+}
