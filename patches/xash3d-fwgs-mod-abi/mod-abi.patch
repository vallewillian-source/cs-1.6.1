+/*
+================
+IN_ModAppendMove
+
+Aplica a amostra de input do Mod (ABI v5) no usercmd do frame.
+
+Chamado do CL_CreateCmd logo depois do CL_CreateMove do cliente e da
+IN_EngineAppendMove — de propósito DEPOIS do client DLL, que é quem lê
+mouse/teclado e escreve cmd->buttons por atribuição: assim o Mod vence o
+mouse na mira sem precisar desativá-lo (ele continua navegando menus, que
+caem no corte de cls.key_dest abaixo) e sem tocar no caminho do teclado.
+
+O movimento só é assumido quando o stick saiu da deadzone (valor != 0). Com o
+stick centrado o que veio do teclado permanece — teclado segue como fallback.
+
+"Orientado pela cabeça" não precisa de matemática aqui: o pmove monta o
+wishdir com AngleVectors( cmd.viewangles ) e zera wishvel[2] no chão, então
+basta o Mod injetar o yaw do HMD com o stick cru em forwardmove/sidemove.
+================
+*/
+void IN_ModAppendMove( usercmd_t *cmd, qboolean active )
+{
+	mod_input_sample_t s;
+	float forward, side, up, speed;
+
+	if( !active || cls.key_dest != key_game || cl.paused || cl.intermission )
+		return;
+
+	if( !Mods_GetInput( &s ))
+		return;
+
+	if( s.has_viewangles_abs )
+	{
+		vec3_t angles;
+
+		VectorCopy( s.viewangles_abs, angles );
+		// mesma trava do CL_CreateMove do cliente (cl_pitchup/cl_pitchdown = 89):
+		// o render pode olhar mais longe (o Mod_Camera usa a pose crua do HMD),
+		// mas o que vai ao servidor fica dentro do que o jogo aceita.
+		angles[PITCH] = bound( -89.0f, angles[PITCH], 89.0f );
+		VectorCopy( angles, cmd->viewangles );
+		VectorCopy( angles, cl.viewangles );
+	}
+
+	forward = s.move_forward * cl_forwardspeed.value;
+	side    = s.move_side * cl_sidespeed.value;
+
+	// cl_upspeed e cl_movespeedkey são registrados pelo client DLL; se ele não
+	// estiver carregado (ou a variável sumir), caímos nos defaults do GoldSrc
+	// em vez de zerar o movimento.
+	{
+		float upspeed = Cvar_VariableValue( "cl_upspeed" );
+
+		if( upspeed <= 0.0f )
+			upspeed = 320.0f;
+
+		up = s.move_up * upspeed;
+	}
+
+	if( FBitSet( s.buttons_state, MOD_BTN_WALK ))
+	{
+		speed = Cvar_VariableValue( "cl_movespeedkey" );
+		if( speed <= 0.0f || speed > 1.0f )
+			speed = 0.52f; // valor do +speed do CS
+
+		forward *= speed;
+		side    *= speed;
+		up      *= speed;
+	}
+
+	if( s.move_forward != 0.0f ) cmd->forwardmove = forward;
+	if( s.move_side    != 0.0f ) cmd->sidemove    = side;
+	if( s.move_up      != 0.0f ) cmd->upmove      = up;
+
+	// bits de usercmd do protocolo GoldSrc (common/const.h:643-658). MOD_BTN_MENU
+	// não tem bit equivalente: quem trata é o próprio Mod.
+	if( FBitSet( s.buttons_state, MOD_BTN_ATTACK ))  cmd->buttons |= IN_ATTACK;
+	if( FBitSet( s.buttons_state, MOD_BTN_ATTACK2 )) cmd->buttons |= IN_ATTACK2;
+	if( FBitSet( s.buttons_state, MOD_BTN_JUMP ))    cmd->buttons |= IN_JUMP;
+	if( FBitSet( s.buttons_state, MOD_BTN_USE ))     cmd->buttons |= IN_USE;
+	if( FBitSet( s.buttons_state, MOD_BTN_RELOAD ))  cmd->buttons |= IN_RELOAD;
+	if( FBitSet( s.buttons_state, MOD_BTN_CROUCH ))  cmd->buttons |= IN_DUCK;
+	if( FBitSet( s.buttons_state, MOD_BTN_SCORE ))   cmd->buttons |= IN_SCORE;
+}
