+/*
+=============
+CL_GetMousePosition
+
+Slot GetMousePosition do cl_enginefunc_t — é o que o client DLL usa para mover
+o cursor dos menus dele (HUD_Frame → g_pMenu->MouseMove). Wrapper para casar a
+assinatura void(int*,int*) do slot e, principalmente, para o cursor VIRTUAL do
+Mod VR (ABI v8) valer aqui: este caminho e o UI_MouseMove são os DOIS
+consumidores de cursor do engine e precisam ler a MESMA posição, senão um
+reposiciona por cima do outro e o hover do menu pisca.
+=============
+*/
+static void GAME_EXPORT CL_GetMousePosition( int *mx, int *my )
+{
+	IN_GetCursorPos( mx, my );
